{
  "name": "local-ollama",
  "private": true,
  "description": "ollama ui - a Windows desktop model manager for Ollama",
  "license": "MIT",
  "engines": { "node": ">=22.12.0" },
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "tauri": "tauri",
    "desktop:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop.ps1 -Mode dev",
    "desktop:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop.ps1 -Mode build",
    "desktop:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop.ps1 -Mode check",
    "desktop:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop.ps1 -Mode test",
    "desktop:fmt": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop.ps1 -Mode fmt",
    "desktop:fmt:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop.ps1 -Mode fmt-check"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/cli": "^2.10.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
